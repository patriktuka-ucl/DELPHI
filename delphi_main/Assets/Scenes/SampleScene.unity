  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Delphi.Session.DelphiQuestionnaire
  questions:
  - key: trust
    text: I trusted the car to handle the situation.
    steps: 21
    lowLabel: Not at all
    highLabel: Completely
    inverted: 0
  - key: predictability
    text: The car's behaviour was predictable.
    steps: 21
    lowLabel: Very unpredictable
    highLabel: Very predictable
    inverted: 0
  - key: efficiency
    text: The car made good progress towards the destination.
    steps: 21
    lowLabel: Very inefficient
    highLabel: Very efficient
    inverted: 0
  - key: satisfaction
    text: I was satisfied with how the car drove.
    steps: 21
    lowLabel: Very dissatisfied
    highLabel: Very satisfied
    inverted: 0
  - key: perceivedSafety
    text: I felt safe during this drive.
    steps: 21
    lowLabel: Very unsafe
    highLabel: Very safe
    inverted: 0
  - key: comfort
    text: The ride felt comfortable.
    steps: 21
    lowLabel: Very uncomfortable
    highLabel: Very comfortable
    inverted: 0
  - key: risk
    text: I felt at risk during this drive.
    steps: 21
    lowLabel: No risk at all
    highLabel: Extreme risk
    inverted: 1
